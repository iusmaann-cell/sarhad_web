{
  "name": "sarhad",
  "private": true,
  "description": "Sarhad restaurant platform: customer website, mobile apps and back office",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@sarhad/web",
    "dev:admin": "turbo run dev --filter=@sarhad/admin",
    "dev:mobile": "pnpm --filter @sarhad/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.0.0",
    "turbo": "^2.11.13",
    "typescript": "^5.9.0"
  }
}
