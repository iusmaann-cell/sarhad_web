# Copy to apps/web/.env.local and apps/admin/.env.local.
# Local values are printed by `pnpm db:start` (API URL and publishable/anon key).
# For a hosted Supabase project: Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URLs, used in email links. Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Map style for the delivery zone maps. Optional: defaults to the free OpenFreeMap style.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Website only (apps/web/.env.local). Needed for online payments: lets the server
# read gateway keys and record confirmed payments. Never expose it to browsers or the app.
# SUPABASE_SECRET_KEY=
# Allow the built-in test gateway in a production build (local testing only).
# ALLOW_TEST_GATEWAY=true

# Restaurant contact details shown when a customer's delivery area is not listed.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
