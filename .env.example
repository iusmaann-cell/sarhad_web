# Copy to apps/web/.env.local and apps/admin/.env.local.
# Local values are printed by `pnpm db:start` (API URL and publishable/anon key).
# For a hosted Supabase project: Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URLs, used in email links. Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
